<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:controle_ja_mobile.Behaviors"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             x:Class="controle_ja_mobile.Views.Publics.LoginPage"
             x:DataType="vm:LoginViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#001524"
             Title="Login">

    <ScrollView VerticalOptions="FillAndExpand">
        <ScrollView.Behaviors>
            <behaviors:KeyboardAvoidanceBehavior/>
        </ScrollView.Behaviors>

        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center" MinimumHeightRequest="600">

            <Image Source="logo_controle.png" HeightRequest="90" Aspect="AspectFit" Margin="0,20,0,10"/>

            <VerticalStackLayout Spacing="5" Margin="0,0,0,20">
                <Label Text="Bem-vindo de volta!" 
                       TextColor="White" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center"/>
                <Label Text="Faça login para continuar" 
                       TextColor="#94A3B8" 
                       FontSize="14" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 12" Padding="15,0">
                <Entry Placeholder="E-mail" 
                       Text="{Binding Email}" 
                       Keyboard="Email" 
                       TextColor="White" 
                       PlaceholderColor="#64748B"
                       BackgroundColor="Transparent"/>
            </Border>

            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 12" Padding="15,0">
                <Entry Placeholder="Senha" 
                       Text="{Binding Password}" 
                       IsPassword="True" 
                       TextColor="White" 
                       PlaceholderColor="#64748B"
                       BackgroundColor="Transparent"/>
            </Border>

            <Label Text="Esqueceu sua senha?" 
                   TextColor="#00E676" 
                   FontSize="14" 
                   FontAttributes="Bold"
                   HorizontalOptions="End">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Button Text="ENTRAR" 
                    Command="{Binding LoginCommand}" 
                    BackgroundColor="#00E676" 
                    TextColor="#001524" 
                    FontAttributes="Bold" 
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="55"
                    Margin="0,15,0,0" />

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                <Label Text="Ainda não tem conta?" TextColor="#94A3B8" FontSize="14"/>
                <Label Text="Crie agora" TextColor="#00E676" FontAttributes="Bold" FontSize="14">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>