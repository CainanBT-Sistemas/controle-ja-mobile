<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="controle_ja_mobile.Views.Publics.WelcomePage"
             BackgroundColor="#001524"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">

        <Grid x:Name="LoadingOverlay"
              IsVisible="False"
              Grid.RowSpan="2"
              ZIndex="99"
              BackgroundColor="#CC000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#00E676" HeightRequest="50" WidthRequest="50"/>
                <Label Text="Conectando..." TextColor="White" HorizontalOptions="Center" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="20" Padding="30">

            <Image Source="logo_controle.png" HeightRequest="120" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,10"/>

            <Label Text="ASSUMA O CONTROLE" 
                   TextColor="White" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   CharacterSpacing="1" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Gestão financeira inteligente e controle veicular." 
                   TextColor="#94A3B8" 
                   FontSize="16" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,0,0,0"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="15" Padding="30,0,30,50">

            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#DB4437" HeightRequest="55">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoogleLoginClicked"/>
                </Border.GestureRecognizers>

                <Grid>
                    <Image Source="google_white_logo.png" 
                           Aspect="AspectFit"
                           HeightRequest="24"
                           WidthRequest="24"
                           HorizontalOptions="Start" 
                           VerticalOptions="Center"
                           Margin="20,0,0,0"/>

                    <Label Text="ENTRAR COM GOOGLE" 
                           TextColor="White" 
                           FontAttributes="Bold" 
                           FontSize="15" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center"/>
                </Grid>
            </Border>

            <Button Text="ENTRAR COM E-MAIL"
                    Clicked="OnLoginClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    BorderColor="#334155"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    HeightRequest="55"
                    FontSize="15"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>