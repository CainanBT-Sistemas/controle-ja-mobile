<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:controle_ja_mobile.Behaviors"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             x:Class="controle_ja_mobile.Views.Publics.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#001524"
             Title="Registrar">

    <ScrollView VerticalOptions="FillAndExpand">
        <ScrollView.Behaviors>
            <behaviors:KeyboardAvoidanceBehavior />
        </ScrollView.Behaviors>

        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center" MinimumHeightRequest="650">

            <Image Source="logo_controle.png" HeightRequest="80" Aspect="AspectFit" Margin="0,10,0,10"/>

            <VerticalStackLayout Spacing="5" Margin="0,0,0,15">
                <Label Text="Crie sua conta" 
                       TextColor="White" 
                       FontSize="26" 
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"/>
                <Label Text="Junte-se a nós e assuma o controle" 
                       TextColor="#94A3B8" 
                       FontSize="14" 
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 12" Padding="15,0">
                <Entry Placeholder="Nome Completo" 
                       Text="{Binding Name}" 
                       Keyboard="Default" 
                       TextColor="White" 
                       PlaceholderColor="#64748B"
                       BackgroundColor="Transparent"/>
            </Border>

            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 12" Padding="15,0">
                <Entry Placeholder="E-mail" 
                       Text="{Binding Email}" 
                       Keyboard="Email" 
                       TextColor="White" 
                       PlaceholderColor="#64748B"
                       BackgroundColor="Transparent"/>
            </Border>

            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 12" Padding="15,0">
                <Entry Placeholder="Senha" 
                       Text="{Binding Password}" 
                       IsPassword="True" 
                       TextColor="White" 
                       PlaceholderColor="#64748B"
                       BackgroundColor="Transparent"/>
            </Border>

            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 12" Padding="15,0">
                <Entry Placeholder="Confirme sua senha" 
                       Text="{Binding ConfirmPassword}" 
                       IsPassword="True" 
                       TextColor="White" 
                       PlaceholderColor="#64748B"
                       BackgroundColor="Transparent"/>
            </Border>

            <Button Text="REGISTRAR" 
                    Command="{Binding RegisterCommand}" 
                    BackgroundColor="#00E676" 
                    TextColor="#001524" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="55"
                    Margin="0,15,0,0"/>

            <Button Text="Voltar para Login" 
                    Command="{Binding GoBackCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#A1A1AA"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="50"
                    Margin="0,5,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>