<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:controle_ja_mobile.Helpers"
             x:Class="controle_ja_mobile.Views.Components.BottomMenu">

    <Grid VerticalOptions="End" HeightRequest="100" InputTransparent="False">

        <Path Fill="#1E293B" StrokeThickness="0" Aspect="Fill" VerticalOptions="End" HeightRequest="80" HorizontalOptions="Fill">
            <Path.Data>
                <GeometryGroup>
                    <PathGeometry Figures="M 0,0 L 0,80 L 400,80 L 400,0 Z"/>
                </GeometryGroup>
            </Path.Data>
            <Path.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="10" Opacity="0.2"/>
            </Path.Shadow>
        </Path>

        <Grid ColumnDefinitions="*,*,*,*,*" Padding="0,20,0,0" VerticalOptions="End" HeightRequest="80">

            <Grid Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeClicked"/>
                </Grid.GestureRecognizers>
                <Label x:Name="IconHome" Text="{x:Static icons:MaterialIcons.Home}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center" VerticalOptions="Start"/>
                <Label x:Name="LblHome" Text="Início" TextColor="#64748B" FontSize="10" FontAttributes="Bold" Margin="0,30,0,0" HorizontalOptions="Center"/>
            </Grid>

            <Grid Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTransactionsClicked"/>
                </Grid.GestureRecognizers>
                <Label x:Name="IconTransactions" Text="{x:Static icons:MaterialIcons.ReceiptLong}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center" VerticalOptions="Start"/>
                <Label x:Name="LblTransactions" Text="Extrato" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
            </Grid>

            <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCardsClicked"/>
                </Grid.GestureRecognizers>
                <Label x:Name="IconCards" Text="{x:Static icons:MaterialIcons.CreditCard}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center" VerticalOptions="Start"/>
                <Label x:Name="LblCards" Text="Cartões" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
            </Grid>

            <Grid Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVehiclesClicked"/>
                </Grid.GestureRecognizers>
                <Label x:Name="IconVehicles" Text="{x:Static icons:MaterialIcons.DirectionsCar}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center" VerticalOptions="Start"/>
                <Label x:Name="LblVehicles" Text="Veículos" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
            </Grid>

            <Grid Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                </Grid.GestureRecognizers>
                <Label x:Name="IconSettings" Text="{x:Static icons:MaterialIcons.Person}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center" VerticalOptions="Start"/>
                <Label x:Name="LblSettings" Text="Perfil" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
            </Grid>
        </Grid>

        <Grid VerticalOptions="End" HorizontalOptions="End" Margin="0,0,15,80" InputTransparent="True" CascadeInputTransparent="False">

            <Button x:Name="BtnIncome" Clicked="OnNewIncomeClicked" BackgroundColor="#00E676" HeightRequest="50" WidthRequest="50" CornerRadius="25" Opacity="0" InputTransparent="True"/>
            <Grid x:Name="GridIncome" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0" InputTransparent="True">
                <Label Text="{x:Static icons:MaterialIcons.TrendingUp}" 
                       FontFamily="MaterialIcons" 
                       TextColor="#001524" 
                       FontSize="26" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Grid>

            <Button x:Name="BtnExpense" Clicked="OnNewExpenseClicked" BackgroundColor="#FF5252" HeightRequest="50" WidthRequest="50" CornerRadius="25" Opacity="0" InputTransparent="True"/>
            <Grid x:Name="GridExpense" HeightRequest="50" WidthRequest="50" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0" InputTransparent="True">
                <Label Text="{x:Static icons:MaterialIcons.TrendingDown}" 
                       FontFamily="MaterialIcons" 
                       TextColor="#FFFFFF" 
                       FontSize="26" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Grid>

            <Grid HeightRequest="60" WidthRequest="60" Margin="0,0,0,10" HorizontalOptions="Center" VerticalOptions="Center">

                <Button x:Name="FabButton" 
                        Clicked="OnFabClicked" 
                        BackgroundColor="#00E676" 
                        CornerRadius="30" />

                <Label x:Name="FabIcon" 
                       Text="{x:Static icons:MaterialIcons.Add}" 
                       FontFamily="MaterialIcons" 
                       TextColor="#001524" 
                       FontSize="34" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       InputTransparent="True" />
            </Grid>

        </Grid>
    </Grid>
</ContentView>