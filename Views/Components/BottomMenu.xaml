<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:controle_ja_mobile.Helpers"
             x:Class="controle_ja_mobile.Views.Components.BottomMenu">

    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">

        <BoxView x:Name="FabOverlay" BackgroundColor="Black" Opacity="0" IsVisible="False" ZIndex="3" VerticalOptions="Fill" HorizontalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseFabMenuTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <VerticalStackLayout x:Name="FabMenuContainer" IsVisible="False" Opacity="0" Spacing="15" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,105" ZIndex="4" TranslationY="20">

            <HorizontalStackLayout Spacing="15" HorizontalOptions="End">
                <Border BackgroundColor="#B3000000" StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                    <Label Text="Transferência" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                </Border>
                <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" BackgroundColor="#3B82F6" StrokeThickness="0" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewTransferClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:MaterialIcons.Repeat}" FontFamily="MaterialIcons" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="15" HorizontalOptions="End">
                <Border BackgroundColor="#B3000000" StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                    <Label Text="Receita" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                </Border>
                <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" BackgroundColor="#00E676" StrokeThickness="0" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewIncomeClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:MaterialIcons.TrendingUp}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" FontAttributes="Bold"/>
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="15" HorizontalOptions="End">
                <Border BackgroundColor="#B3000000" StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                    <Label Text="Despesa no Cartão" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                </Border>
                <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" BackgroundColor="#9333EA" StrokeThickness="0" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewCreditCardExpenseClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:MaterialIcons.CreditCard}" FontFamily="MaterialIcons" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" FontAttributes="Bold"/>
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="15" HorizontalOptions="End">
                <Border BackgroundColor="#B3000000" StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                    <Label Text="Despesa" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                </Border>
                <Border WidthRequest="48" HeightRequest="48" StrokeShape="RoundRectangle 24" BackgroundColor="#FF5252" StrokeThickness="0" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNewExpenseClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static icons:MaterialIcons.TrendingDown}" FontFamily="MaterialIcons" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" FontAttributes="Bold"/>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Grid VerticalOptions="End" HeightRequest="120" ZIndex="2">
            <Grid.Shadow>
                <Shadow Brush="Black" Offset="0,-5" Radius="15" Opacity="0.5"/>
            </Grid.Shadow>

            <Border BackgroundColor="#0A0F17" WidthRequest="85" HeightRequest="85" StrokeShape="RoundRectangle 42.5" StrokeThickness="0" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,22" />

            <Border BackgroundColor="#0A0F17" VerticalOptions="End" HeightRequest="70" StrokeThickness="0" StrokeShape="RoundRectangle 15,15,0,0">
                <Grid ColumnDefinitions="*,*,*,*,*" Padding="0,5,0,0">
                    <Grid Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeClicked"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="IconHome" Text="{x:Static icons:MaterialIcons.Home}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center"/>
                        <Label x:Name="LblHome" Text="Principal" TextColor="#64748B" FontSize="10" FontAttributes="Bold" Margin="0,30,0,0" HorizontalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTransactionsClicked"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="IconTransactions" Text="{x:Static icons:MaterialIcons.ReceiptLong}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center"/>
                        <Label x:Name="LblTransactions" Text="Transações" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Column="2" />

                    <Grid Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVehiclesClicked"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="IconVehicles" Text="{x:Static icons:MaterialIcons.DirectionsCar}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center"/>
                        <Label x:Name="LblVehicles" Text="Planejamento" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
                    </Grid>

                    <Grid Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsClicked"/>
                        </Grid.GestureRecognizers>
                        <Label x:Name="IconSettings" Text="{x:Static icons:MaterialIcons.Person}" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="26" HorizontalOptions="Center"/>
                        <Label x:Name="LblSettings" Text="Mais" TextColor="#64748B" FontSize="10" Margin="0,30,0,0" HorizontalOptions="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="MainFabBorder" BackgroundColor="#00E676" StrokeThickness="0" HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 32" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,32" ZIndex="5">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.4"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMainFabClicked"/>
            </Border.GestureRecognizers>
            <Label x:Name="MainFabIcon" Text="{x:Static icons:MaterialIcons.Add}" FontFamily="MaterialIcons" TextColor="#121214" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
        </Border>

    </Grid>
</ContentView>