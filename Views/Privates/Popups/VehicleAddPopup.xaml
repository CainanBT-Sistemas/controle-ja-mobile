<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
               xmlns:behaviors="clr-namespace:controle_ja_mobile.Behaviors"
               x:Class="controle_ja_mobile.Views.Popups.VehicleAddPopup"
               Color="Transparent">

    <Border BackgroundColor="#001524" 
            StrokeThickness="0" 
            StrokeShape="RoundRectangle 25,25,0,0"
            VerticalOptions="End" 
            HeightRequest="600"
            WidthRequest="400">

        <Grid RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,20,20,10">
                <Label Grid.Column="0" Text="close" FontFamily="MaterialIcons" TextColor="#94A3B8" FontSize="26" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,10,20,20" Spacing="20">

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 40" BackgroundColor="#2D3A4F" StrokeThickness="0">
                            <Label Text="&#xe531;" FontFamily="MaterialIcons" TextColor="White" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Apelido (ex: Meu Fusca)" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Entry Text="{Binding Name}" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Marca" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                                <Entry Text="{Binding Brand}" IsReadOnly="{Binding IsEditMode}" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Modelo" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                                <Entry Text="{Binding Model}" IsReadOnly="{Binding IsEditMode}" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Ano" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                                <Entry Text="{Binding Year}" IsReadOnly="{Binding IsEditMode}" Keyboard="Numeric" MaxLength="4" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Placa" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                            <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                                <Entry Text="{Binding Plate}" TextTransform="Uppercase" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Quilometragem Atual" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Entry Text="{Binding CurrentOdometer}" IsReadOnly="{Binding IsEditMode}" Keyboard="Numeric" TextColor="#00E676" FontAttributes="Bold" FontSize="16" BackgroundColor="Transparent">
                                <Entry.Behaviors>
                                    <behaviors:NumericMaskBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Padding="20,10,20,30" Spacing="10">
                <Button Text="Salvar Veículo" Command="{Binding SaveCommand}" BackgroundColor="#00E676" TextColor="#001524" FontAttributes="Bold" FontSize="16" HeightRequest="55" CornerRadius="12"/>
                <Button Text="Excluir Veículo" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}" BackgroundColor="Transparent" TextColor="#FF5252" BorderColor="#FF5252" BorderWidth="1" FontAttributes="Bold" FontSize="14" HeightRequest="50" CornerRadius="12"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</toolkit:Popup>