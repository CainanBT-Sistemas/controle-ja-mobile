<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
               xmlns:models="clr-namespace:controle_ja_mobile.Models"
               xmlns:components="clr-namespace:controle_ja_mobile.Views.Components"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="controle_ja_mobile.Views.Popups.ManageCategoriesPopup"
               Color="Transparent">

    <Border BackgroundColor="#0F172A" 
            StrokeThickness="0" 
            StrokeShape="RoundRectangle 25,25,0,0"
            VerticalOptions="End" 
            HeightRequest="750"
            WidthRequest="400">

        <Grid RowDefinitions="Auto, Auto, *">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,20,20,10">
                <Label Grid.Column="0" Text="expand_more" FontFamily="MaterialIcons" TextColor="#94A3B8" FontSize="32" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="Categorias" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border Grid.Column="2" BackgroundColor="#00E676" StrokeThickness="0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddCategoryCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="+" TextColor="#001524" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="22" Margin="0,-2,0,0"/>
                </Border>
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="15" Padding="20,10">
                <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 25" HeightRequest="50" Padding="5">
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Text="DESPESAS" Command="{Binding ShowExpensesCommand}" CornerRadius="20" FontSize="12" FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsShowingExpenses}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#2D3B4E" />
                                    <Setter Property="TextColor" Value="#FF5252" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsShowingExpenses}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="TextColor" Value="#64748B" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="RECEITAS" Command="{Binding ShowIncomesCommand}" CornerRadius="20" FontSize="12" FontAttributes="Bold">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsShowingIncomes}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#2D3B4E" />
                                    <Setter Property="TextColor" Value="#00E676" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding IsShowingIncomes}" Value="False">
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="TextColor" Value="#64748B" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Grid Grid.Row="2">
                <RefreshView Command="{Binding LoadCategoriesCommand}" IsRefreshing="{Binding IsRefreshing}" IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                    <CollectionView ItemsSource="{Binding DisplayedCategories}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <VerticalStackLayout Spacing="5" Margin="20,0,20,15">

                                    <Border StrokeThickness="0" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 16" HeightRequest="75">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=OpenCategoryDetailsCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="70, *, Auto, 45">
                                            <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="{Binding Color}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Center">
                                                <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                                <Label Text="{Binding ChildrenCount, StringFormat='{0} subcategorias'}" TextColor="#64748B" FontSize="11" IsVisible="{Binding HasChildren}"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="3" Text="edit" FontFamily="MaterialIcons" TextColor="#475569" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackLayout BindableLayout.ItemsSource="{Binding SubCategories}" Margin="30,0,0,0" Spacing="0" IsVisible="{Binding HasChildren}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:Category">
                                                <Grid ColumnDefinitions="40, Auto, *, Auto" HeightRequest="50">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=OpenCategoryDetailsCommand}" CommandParameter="{Binding .}"/>
                                                    </Grid.GestureRecognizers>

                                                    <Label Grid.Column="0" Text="subdirectory_arrow_right" FontFamily="MaterialIcons" TextColor="{Binding ParentColor}" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.8"/>
                                                    <Border Grid.Column="1" HeightRequest="10" WidthRequest="10" StrokeShape="RoundRectangle 5" BackgroundColor="{Binding Color}" StrokeThickness="0" VerticalOptions="Center" Margin="0,0,10,0"/>
                                                    <Label Grid.Column="2" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="15" VerticalOptions="Center"/>
                                                    <Label Grid.Column="3" Text="chevron_right" FontFamily="MaterialIcons" TextColor="#334155" FontSize="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </StackLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <VerticalStackLayout IsVisible="{Binding IsLoading}" BackgroundColor="#0F172A" Spacing="0" Padding="0,10,0,0">
                    <components:SkeletonItem />
                    <components:SkeletonItem />
                    <components:SkeletonItem />
                    <components:SkeletonItem />
                </VerticalStackLayout>
            </Grid>

        </Grid>
    </Border>
</toolkit:Popup>