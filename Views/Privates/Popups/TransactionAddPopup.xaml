<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
               x:Class="controle_ja_mobile.Views.Popups.TransactionAddPopup"
               Color="Transparent">

    <Border BackgroundColor="#121214" 
            StrokeThickness="0" 
            StrokeShape="RoundRectangle 25,25,0,0"
            VerticalOptions="End" 
            HeightRequest="750"
            WidthRequest="400">

        <Grid RowDefinitions="Auto, *">
            <Grid Grid.Row="0" Padding="20,20,20,10">
                <Label Text="close" FontFamily="MaterialIcons" TextColor="#94A3B8" FontSize="26" HorizontalOptions="Start" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding AmountTitle}" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsLoading}" Padding="20" Spacing="15">
                <BoxView HeightRequest="75" CornerRadius="12" Color="#1E2A3A"/>
                <BoxView HeightRequest="65" CornerRadius="8" Color="#1E2A3A"/>
                <BoxView HeightRequest="65" CornerRadius="8" Color="#1E2A3A"/>
                <BoxView HeightRequest="65" CornerRadius="8" Color="#1E2A3A"/>
                <BoxView HeightRequest="65" CornerRadius="8" Color="#1E2A3A"/>
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Padding="20,10,20,40" Spacing="0">

                    <Grid HeightRequest="75" ColumnDefinitions="40, *, Auto" IsEnabled="{Binding IsEditable}" Opacity="{Binding FormOpacity}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCalculatorCommand}"/>
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="attach_money" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0" Spacing="5">
                            <Label Text="R$" TextColor="#A1A1AA" FontSize="22" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="{Binding Amount}" FontSize="28" FontAttributes="Bold" TextColor="{Binding SemanticColor}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="2" Text="BRL ▼" TextColor="#64748B" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                    <VerticalStackLayout IsVisible="{Binding HasTypeSelected}" Spacing="0" IsEnabled="{Binding IsEditable}" Opacity="{Binding FormOpacity}">

                        <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto" IsVisible="{Binding IsStatusVisible}">
                            <Label Grid.Column="0" Text="check_circle_outline" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding PaidLabelText}" TextColor="White" FontSize="15" VerticalOptions="Center" Margin="10,0,0,0"/>
                            <Switch Grid.Column="2" IsToggled="{Binding IsPaid}" OnColor="{Binding SemanticColor}" ThumbColor="White" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0" IsVisible="{Binding IsStatusVisible}"/>

                        <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto">
                            <Label Grid.Column="0" Text="calendar_today" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding FormattedDate}" TextColor="White" FontSize="15" VerticalOptions="Center" Margin="10,0,0,0" InputTransparent="True"/>
                            <DatePicker Grid.Column="1" Grid.ColumnSpan="2" Date="{Binding Date, Mode=TwoWay}" Opacity="0.01" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                        <Grid HeightRequest="65" ColumnDefinitions="40, *">
                            <Label Grid.Column="0" Text="label" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Entry Grid.Column="1" Text="{Binding TransactionName}" Placeholder="Nome" TextColor="White" PlaceholderColor="#A1A1AA" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                        <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto" IsVisible="{Binding IsCategoryVisible}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSelectCategoryCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="bookmark_border" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Selecionar Categoria" TextColor="#A1A1AA" FontSize="15" Margin="10,0,0,0" IsVisible="{Binding IsCategoryEmpty}"/>
                                <Border Stroke="{Binding SelectedCategory.Color}" StrokeThickness="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 16" HorizontalOptions="Start" Padding="12,6" Margin="10,0,0,0" IsVisible="{Binding HasCategory}">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding SelectedCategory.Icon}" FontFamily="MaterialIcons" TextColor="{Binding SelectedCategory.Color}" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="{Binding SelectedCategory.Name}" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Label Grid.Column="2" Text="chevron_right" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="24" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0" IsVisible="{Binding IsCategoryVisible}"/>

                        <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSelectSourceCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="account_balance_wallet" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding SourceAccountTitle}" TextColor="#A1A1AA" FontSize="15" Margin="10,0,0,0" IsVisible="{Binding IsSourceEmpty}"/>
                                <Border Stroke="{Binding SelectedSource.Color}" StrokeThickness="1" BackgroundColor="Transparent" StrokeShape="RoundRectangle 16" HorizontalOptions="Start" VerticalOptions="Center" Padding="12,6" Margin="10,0,0,0" IsVisible="{Binding HasSource}">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding SelectedSource.Icon}" FontFamily="MaterialIcons" TextColor="{Binding SelectedSource.Color}" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="{Binding SelectedSource.Name}" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                            <Label Grid.Column="2" Text="chevron_right" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="24" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                        <Grid HeightRequest="60" Margin="0,15,0,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMoreDetailsCommand}"/>
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding MoreDetailsText}" TextColor="{Binding SemanticColor}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding ShowMoreDetails}" Spacing="0" Margin="0,10,0,0">

                            <Grid HeightRequest="65" ColumnDefinitions="40, *">
                                <Label Grid.Column="0" Text="notes" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding Description}" Placeholder="Descrição ou observação" TextColor="White" PlaceholderColor="#A1A1AA" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center" Margin="10,0,0,0"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                            <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto">
                                <Label Grid.Column="0" Text="repeat" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Label Grid.Column="1" Text="Lançamento Fixo" TextColor="White" FontSize="15" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Switch Grid.Column="2" IsToggled="{Binding IsFixed}" OnColor="{Binding SemanticColor}" ThumbColor="White" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                            <VerticalStackLayout IsVisible="{Binding IsFixed}" Spacing="0">
                                <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto">
                                    <Label Grid.Column="1" Text="Frequência" TextColor="#A1A1AA" FontSize="15" VerticalOptions="Center" Margin="10,0,0,0"/>
                                    <Picker Grid.Column="2" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="End" WidthRequest="150"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>
                            </VerticalStackLayout>

                            <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto" IsVisible="{Binding IsFixed, Converter={StaticResource InvertedBoolConverter}}">
                                <Label Grid.Column="0" Text="layers" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Label Grid.Column="1" Text="Parcelar lançamento?" TextColor="White" FontSize="15" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Switch Grid.Column="2" IsToggled="{Binding IsRecurring}" OnColor="{Binding SemanticColor}" ThumbColor="White" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0" IsVisible="{Binding IsFixed, Converter={StaticResource InvertedBoolConverter}}"/>

                            <VerticalStackLayout IsVisible="{Binding IsRecurring}" Spacing="0">
                                <Grid HeightRequest="65" ColumnDefinitions="40, *, Auto">
                                    <Label Grid.Column="1" Text="Qtd. de Parcelas" TextColor="#A1A1AA" FontSize="15" VerticalOptions="Center" Margin="10,0,0,0"/>
                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="10">
                                        <Entry Text="{Binding Installments}" Keyboard="Numeric" TextColor="White" FontSize="16" WidthRequest="60" HorizontalTextAlignment="Center" BackgroundColor="#202024"/>
                                        <Label Text="x" TextColor="#A1A1AA" FontSize="16" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>
                                <Label Text="{Binding InstallmentSimulation}" TextColor="{Binding SemanticColor}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" Margin="0,10,0,10"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding IsStatusVisible}" Spacing="0">
                                <Label Text="Dados do Veículo (Opcional)" TextColor="{Binding SemanticColor}" FontSize="12" FontAttributes="Bold" Margin="50,20,0,10"/>
                                <Grid HeightRequest="65" ColumnDefinitions="40, *">
                                    <Label Grid.Column="0" Text="directions_car" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <Entry Grid.Column="1" Text="{Binding VehicleName}" Placeholder="Veículo associado" TextColor="White" PlaceholderColor="#A1A1AA" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>

                                <Grid HeightRequest="65" ColumnDefinitions="40, *, *">
                                    <Label Grid.Column="0" Text="speed" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" VerticalOptions="Center" HorizontalOptions="Center"/>
                                    <Entry Grid.Column="1" Text="{Binding CurrentOdometer}" Keyboard="Numeric" Placeholder="Odômetro (Km)" TextColor="White" PlaceholderColor="#A1A1AA" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center" Margin="10,0,0,0"/>
                                    <Entry Grid.Column="2" Text="{Binding Liters}" Keyboard="Numeric" Placeholder="Litros abastecidos" TextColor="White" PlaceholderColor="#A1A1AA" FontSize="15" BackgroundColor="Transparent" VerticalOptions="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#323238" Margin="50,0,0,0"/>
                            </VerticalStackLayout>

                        </VerticalStackLayout>

                        <VerticalStackLayout Margin="0,30,0,0" Spacing="15" IsVisible="{Binding HasTypeSelected}">
                            <Button Text="Salvar e Lançar Novo" Command="{Binding SaveAndAddCommand}" BackgroundColor="Transparent" TextColor="{Binding SemanticColor}" BorderColor="{Binding SemanticColor}" BorderWidth="1" CornerRadius="32" HeightRequest="60" FontAttributes="Bold" IsVisible="{Binding IsCreationMode}"/>

                            <Border BackgroundColor="{Binding SemanticColor}" StrokeThickness="0" HeightRequest="60" StrokeShape="RoundRectangle 32" HorizontalOptions="Fill" IsVisible="{Binding IsEditable}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SaveAndCloseCommand}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                    <Label Text="check" FontFamily="MaterialIcons" TextColor="White" FontSize="24" VerticalOptions="Center"/>
                                    <Label Text="Salvar Lançamento" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <Button Text="Excluir Lançamento" Command="{Binding DeleteCommand}" BackgroundColor="Transparent" TextColor="#FF5252" BorderColor="#FF5252" BorderWidth="1" CornerRadius="32" HeightRequest="60" FontAttributes="Bold" IsVisible="{Binding IsEditable, Converter={StaticResource InvertedBoolConverter}}"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.RowSpan="2" BackgroundColor="#D9000000" IsVisible="{Binding IsCalculatorOpen}" ZIndex="98">
                <VerticalStackLayout VerticalOptions="End" BackgroundColor="#202024" Padding="25">
                    <Label Text="{Binding CalcDisplay}" TextColor="White" FontSize="36" HorizontalOptions="End"/>
                    <Button Text="FECHAR" Command="{Binding ToggleCalculatorCommand}" BackgroundColor="Transparent" TextColor="White"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Border>
</toolkit:Popup>