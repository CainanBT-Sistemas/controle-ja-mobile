<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
               xmlns:behaviors="clr-namespace:controle_ja_mobile.Behaviors"
               x:Class="controle_ja_mobile.Views.Popups.CreditCardAddPopup"
               Color="Transparent">

    <Border BackgroundColor="#001524" 
            StrokeThickness="0" 
            StrokeShape="RoundRectangle 25,25,0,0"
            VerticalOptions="End" 
            HeightRequest="680"
            WidthRequest="400">

        <Grid RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,20,20,10">
                <Label Grid.Column="0" Text="close" FontFamily="MaterialIcons" TextColor="#94A3B8" FontSize="26" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1" x:Name="MainForm">
                <VerticalStackLayout Padding="20,10,20,20" Spacing="25">

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Pré-visualização" TextColor="#64748B" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Frame HasShadow="False" HeightRequest="80" WidthRequest="80" CornerRadius="8" BackgroundColor="{Binding SelectedColor}" BorderColor="Transparent" Padding="0">
                            <Label Text="credit_card" FontFamily="MaterialIcons" TextColor="White" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome do Cartão" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                            <Entry Text="{Binding Name}" Placeholder="Ex: Nubank, Inter..." PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                        </Frame>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Limite Total" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                            <Entry Text="{Binding Limit}" Keyboard="Numeric" Placeholder="0.00" PlaceholderColor="#64748B" TextColor="#00E676" FontAttributes="Bold" FontSize="16" BackgroundColor="Transparent">
                                <Entry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Frame>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Dia Fechamento" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                            <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                                <Entry Text="{Binding CloseDay}" Keyboard="Numeric" MaxLength="2" Placeholder="Ex: 5" PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                            </Frame>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Dia Vencimento" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                            <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                                <Entry Text="{Binding BestDay}" Keyboard="Numeric" MaxLength="2" Placeholder="Ex: 12" PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Cor de Identificação" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenColorSelectorCommand}"/>
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Frame Grid.Column="0" HasShadow="False" HeightRequest="30" WidthRequest="30" CornerRadius="15" BackgroundColor="{Binding SelectedColor}" BorderColor="Transparent" Padding="0" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Alterar Cor" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <Border IsVisible="{Binding IsColorSelectorOpen}" BackgroundColor="#151F2D" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,5,0,0">
                            <StackLayout>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                    <Label Text="Escolha uma cor" TextColor="#A1A1AA" FontAttributes="Bold" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="close" FontFamily="MaterialIcons" TextColor="#FF5252" FontSize="20" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CloseColorSelectorCommand}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                                <ScrollView MaximumHeightRequest="150">
                                    <FlexLayout BindableLayout.ItemsSource="{Binding AvailableColors}" Wrap="Wrap" JustifyContent="Start">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border BackgroundColor="{Binding .}" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="4">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreditCardAddViewModel}}, Path=SelectColorCommand}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>
                                </ScrollView>
                            </StackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" x:Name="ActionButtons" Padding="20,0,20,20" Spacing="10">
                <Button Text="Salvar Cartão" Command="{Binding SaveCommand}" BackgroundColor="#00E676" TextColor="#001524" FontAttributes="Bold" FontSize="16" HeightRequest="55" CornerRadius="12"/>
                <Button Text="Excluir Cartão" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}" BackgroundColor="Transparent" TextColor="#FF5252" BorderColor="#FF5252" BorderWidth="1" FontAttributes="Bold" FontSize="14" HeightRequest="50" CornerRadius="12"/>
            </VerticalStackLayout>

        </Grid>
    </Border>
</toolkit:Popup>