<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             x:Class="controle_ja_mobile.Views.Privates.Tabs.HomeView"
             x:DataType="vm:DashboardViewModel">

    <Grid BackgroundColor="#001524">

        <ScrollView Padding="0,20,0,100">
            <VerticalStackLayout Spacing="20">

                <Grid Padding="25,0">
                    <Border BackgroundColor="#1E2A3A" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="5">
                        <Grid ColumnDefinitions="40, *, 40">
                            <ImageButton Grid.Column="0" Source="arrow_left.png" Command="{Binding PreviousMonthCommand}" HeightRequest="20" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding CurrentMonthDisplay}" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextTransform="Uppercase" FontSize="14"/>
                            <ImageButton Grid.Column="2" Source="arrow_right.png" Command="{Binding NextMonthCommand}" HeightRequest="20" HorizontalOptions="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Padding="25,5">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" HeightRequest="140">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00E676" Offset="0.0" />
                                <GradientStop Color="#00C853" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <VerticalStackLayout Padding="25" VerticalOptions="Center" Spacing="5">
                            <Label Text="Patrimônio Total" TextColor="#003300" FontSize="14" FontAttributes="Bold" Opacity="0.8"/>
                            <Label Text="{Binding Balance}" TextColor="#001524" FontSize="38" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Padding="25,0">

                    <Border Grid.Column="0" BackgroundColor="#1E2A3A" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="15" HeightRequest="90">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Path Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" Fill="#00E676" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center"/>
                                <Label Text="Entradas" TextColor="#94A3B8" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Income}" TextColor="#00E676" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="#1E2A3A" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="15" HeightRequest="90">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Path Data="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" Fill="#EF4444" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center"/>
                                <Label Text="Saídas" TextColor="#94A3B8" FontSize="13" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding Expense}" TextColor="#EF4444" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <VerticalStackLayout Padding="25,10,25,0" Spacing="10">
                    <Label Text="ANÁLISE DE GASTOS" TextColor="#94A3B8" FontSize="12" FontAttributes="Bold"/>

                    <Border BackgroundColor="#1E2A3A" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="15" HeightRequest="250">
                        <Grid>
                            <micro:ChartView IsVisible="{Binding HasChartData}" Chart="{Binding ExpenseChart}" BackgroundColor="Transparent" />

                            <VerticalStackLayout IsVisible="{Binding HasChartData, Converter={StaticResource InvertedBoolConverter}}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Opacity="0.6">
                                <Border HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 40" BackgroundColor="#2D3A4F" StrokeThickness="0">
                                    <Label Text="!" FontSize="36" TextColor="#94A3B8" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Text="Sem despesas neste período" TextColor="#94A3B8" FontSize="14" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#CC000000" IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#00E676" HeightRequest="50" WidthRequest="50" VerticalOptions="Center" HorizontalOptions="Center"/>
        </Grid>

    </Grid>
</ContentView>