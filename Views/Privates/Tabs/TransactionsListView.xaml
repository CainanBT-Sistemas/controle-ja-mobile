<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             x:Class="controle_ja_mobile.Views.Privates.Tabs.TransactionsListView"
             x:DataType="vm:TransactionsViewModel"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="Transações" TextColor="White" FontSize="24" FontAttributes="Bold"/>
                <Label Text="Histórico de entradas e saídas" TextColor="#94A3B8" FontSize="12"/>
            </VerticalStackLayout>

            <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeThickness="0" HeightRequest="44" WidthRequest="44" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToFiltersCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="filter_list" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto" Padding="20,5,20,15">
            <Label Grid.Column="0" Text="chevron_left" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="36" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PreviousMonthCommand}"/>
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1" Text="{Binding CurrentMonthYear, TargetNullValue='...', FallbackValue='...'}" TextColor="White" FontSize="16" FontAttributes="Bold" TextTransform="Uppercase" HorizontalOptions="Center" VerticalOptions="Center"/>

            <Label Grid.Column="2" Text="chevron_right" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="36" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NextMonthCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <Border Grid.Row="2" BackgroundColor="#1E293B" StrokeThickness="0" Padding="0" VerticalOptions="Fill" HorizontalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25,25,0,0" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto, Auto, *">

                <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Padding="10,20">
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                        <Label Text="Entradas" TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalInFormatted, TargetNullValue='R$ 0,00', FallbackValue='R$ 0,00'}" TextColor="#00E676" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <BoxView Grid.Column="0" WidthRequest="1" Color="#334155" HorizontalOptions="End" VerticalOptions="Fill" Margin="0,5"/>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                        <Label Text="Saídas" TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalOutFormatted, TargetNullValue='R$ 0,00', FallbackValue='R$ 0,00'}" TextColor="#FF5252" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <BoxView Grid.Column="1" WidthRequest="1" Color="#334155" HorizontalOptions="End" VerticalOptions="Fill" Margin="0,5"/>

                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                        <Label Text="Balanço" TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center"/>
                        <Label Text="{Binding BalanceFormatted, TargetNullValue='R$ 0,00', FallbackValue='R$ 0,00'}" TextColor="{Binding BalanceColor, TargetNullValue='#3B82F6', FallbackValue='#3B82F6'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1" Color="#0F172A" Margin="20,0"/>

                <Grid Grid.Row="2" Padding="0,0,0,110">

                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Margin="20,-40,20,0">
                        <Border HeightRequest="110" WidthRequest="110" BackgroundColor="#0F172A" StrokeThickness="0" HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="55" />
                            </Border.StrokeShape>
                            <Label Text="search_off" FontFamily="MaterialIcons" TextColor="#3B82F6" FontSize="48" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Ops! Nenhuma transação." TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Você não possui transações neste mês.&#x0a;Clique no botão (+) para registrar." TextColor="#94A3B8" FontSize="14" HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Transactions}" IsVisible="{Binding HasTransactions}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">

                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,15">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TransactionsViewModel}}, Path=EditTransactionCommand}" CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>

                                    <Border Grid.Column="0" HeightRequest="48" WidthRequest="48" BackgroundColor="#0F172A" StrokeThickness="0" Margin="0,0,15,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="24" />
                                        </Border.StrokeShape>
                                        <Label Text="account_balance_wallet" FontFamily="MaterialIcons" TextColor="{Binding ColorHex}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding CategoryName, TargetNullValue='Sem Categoria', FallbackValue='Sem Categoria'}" TextColor="#94A3B8" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding FormattedAmount}" TextColor="{Binding ColorHex}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Grid>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#00E676" HorizontalOptions="Center" VerticalOptions="Center"/>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>