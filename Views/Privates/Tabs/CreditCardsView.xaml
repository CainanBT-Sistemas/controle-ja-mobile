<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             x:Class="controle_ja_mobile.Views.Privates.Tabs.CreditCardsView">

    <Grid RowDefinitions="Auto, *" BackgroundColor="#001524">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10">
            <Label Grid.Column="1" Text="Cartões de Crédito" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Border Grid.Column="2" BackgroundColor="#00E676" StrokeThickness="0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAddCardCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="+" TextColor="#001524" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="22" Margin="0,-2,0,0"/>
            </Border>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCardsAsyncCommand}" RefreshColor="#00E676">
            <CollectionView ItemsSource="{Binding Cards}" Margin="0,10,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Margin="0,50,0,0">
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="100" WidthRequest="100" StrokeShape="RoundRectangle 50">
                            <Label Text="&#xe870;" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5"/>
                        </Border>
                        <Label Text="Nenhum cartão cadastrado" TextColor="#64748B" FontSize="16" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CreditCard">
                        <VerticalStackLayout>
                            <Border StrokeThickness="0" BackgroundColor="Transparent" Padding="15">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CreditCardsViewModel}}, Path=OpenCardDetailsCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#151F2D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="60, *, Auto">

                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" HeightRequest="46" WidthRequest="46" StrokeShape="RoundRectangle 8" BackgroundColor="{Binding Color}" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="White" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding InvoiceInfo}" TextColor="#64748B" FontSize="12"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Row="0" Grid.Column="2" Text="&#xe5cc;" FontFamily="MaterialIcons" TextColor="#3F3F46" FontSize="24" VerticalOptions="Center" HorizontalOptions="End"/>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,15,0,0" Spacing="5">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding FormattedUsed, StringFormat='Usado: {0}'}" TextColor="#A1A1AA" FontSize="12"/>
                                            <Label Grid.Column="1" Text="{Binding FormattedAvailable, StringFormat='Livre: {0}'}" TextColor="#00E676" FontSize="12" FontAttributes="Bold"/>
                                        </Grid>
                                        <ProgressBar Progress="{Binding LimitProgress}" ProgressColor="{Binding Color}" BackgroundColor="#1E2A3A" HeightRequest="6"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" Color="#1E2A3A" Margin="15,0,15,0"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentView>