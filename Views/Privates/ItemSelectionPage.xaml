<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             x:Class="controle_ja_mobile.Views.Privates.ItemSelectionPage"
             x:DataType="vm:ItemSelectionViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#09090B">

    <Grid RowDefinitions="Auto, *, Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,40,20,20">
            <Label Grid.Column="0" Text="✕" FontSize="24" TextColor="#64748B" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="{Binding PageTitle}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Grid.Column="2" Text="settings" FontFamily="MaterialIcons" TextColor="#A1A1AA" FontSize="24" VerticalOptions="Center" IsVisible="{Binding IsCategorySelection}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToManageCategoriesCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout BindableLayout.ItemsSource="{Binding Items}" Padding="15,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SelectionItem">
                        <VerticalStackLayout Spacing="0">
                            <Border BackgroundColor="{Binding BgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15,10" Margin="0,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=SelectItemCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                    <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="{Binding Color}" StrokeThickness="0" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" Margin="15,0"/>
                                    <Grid Grid.Column="2" IsVisible="{Binding HasSubItems}" Padding="15,0" VerticalOptions="Center">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=ToggleExpandCommand}" CommandParameter="{Binding .}"/>
                                        </Grid.GestureRecognizers>
                                        <Label Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="▲"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                    <Border Grid.Column="3" WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" Stroke="{Binding CheckColor}" StrokeThickness="2" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding CheckColor}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsSelected}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackLayout IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding SubItems}" Margin="30,0,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:SelectionItem">
                                        <VerticalStackLayout Spacing="0">
                                            <Border BackgroundColor="{Binding BgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15,10" Margin="0,2">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=SelectItemCommand}" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                    <Border Grid.Column="0" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" BackgroundColor="{Binding Color}" StrokeThickness="0" VerticalOptions="Center">
                                                        <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                    <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontSize="15" VerticalOptions="Center" Margin="12,0"/>
                                                    <Grid Grid.Column="2" IsVisible="{Binding HasSubItems}" Padding="15,0" VerticalOptions="Center">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=ToggleExpandCommand}" CommandParameter="{Binding .}"/>
                                                        </Grid.GestureRecognizers>
                                                        <Label Text="▼" TextColor="#64748B" FontSize="12" VerticalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="▲"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Grid>
                                                    <Border Grid.Column="3" WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" Stroke="{Binding CheckColor}" StrokeThickness="2" BackgroundColor="Transparent" VerticalOptions="Center">
                                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="{Binding CheckColor}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsSelected}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackLayout IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding SubItems}" Margin="30,0,0,5">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SelectionItem">
                                                        <Border BackgroundColor="{Binding BgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="15,8" Margin="0,1">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=SelectItemCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <Label Grid.Column="0" Text="subdirectory_arrow_right" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="18" VerticalOptions="Center" Margin="0,0,10,0"/>
                                                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="14" VerticalOptions="Center"/>
                                                                <Border Grid.Column="2" WidthRequest="18" HeightRequest="18" StrokeShape="RoundRectangle 9" Stroke="{Binding CheckColor}" StrokeThickness="2" BackgroundColor="Transparent" VerticalOptions="Center">
                                                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="{Binding CheckColor}" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsSelected}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </StackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                            <BoxView HeightRequest="1" Color="#1E293B" Margin="15,5"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>

        <Grid Grid.Row="2" Padding="20,15,20,25" BackgroundColor="#1E293B">
            <Button Text="CONFIRMAR SELEÇÃO" Command="{Binding ConfirmSelectionCommand}" BackgroundColor="#00E676" TextColor="#001524" FontAttributes="Bold" FontSize="15" HeightRequest="55" CornerRadius="12"/>
        </Grid>
    </Grid>
</ContentPage>