<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             x:Class="controle_ja_mobile.Views.Privates.ItemSelectionPage"
             x:DataType="vm:ItemSelectionViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="20,40,20,15">
            <Label Grid.Column="0" Text="close" FontFamily="MaterialIcons" FontSize="26" TextColor="#94A3B8" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="{Binding PageTitle}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Grid.Column="2" Text="settings" FontFamily="MaterialIcons" TextColor="#94A3B8" FontSize="26" VerticalOptions="Center" IsVisible="{Binding IsCategorySelection}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToManageCategoriesCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1">
            <StackLayout BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SelectionItem">
                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="65, *, Auto" HeightRequest="65" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=SelectItemCommand}" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="{Binding Color}" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>

                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontSize="16" VerticalOptions="Center" FontAttributes="Bold" Margin="5,0"/>

                                <Grid Grid.Column="2" Padding="20,0" VerticalOptions="Center">
                                    <Label Text="check_circle" FontFamily="MaterialIcons" TextColor="#00E676" FontSize="24" IsVisible="{Binding IsSelected}"/>
                                    <Label Text="radio_button_unchecked" FontFamily="MaterialIcons" TextColor="#334155" FontSize="24" IsVisible="{Binding IsSelected, Converter={StaticResource InvertedBoolConverter}}"/>
                                </Grid>
                            </Grid>

                            <StackLayout BindableLayout.ItemsSource="{Binding SubItems}" Margin="10,0,0,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:SelectionItem">
                                        <Grid ColumnDefinitions="45, Auto, *, Auto" HeightRequest="55">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ItemSelectionViewModel}}, Path=SelectItemCommand}" CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>

                                            <Label Grid.Column="0" Text="subdirectory_arrow_right" FontFamily="MaterialIcons" TextColor="{Binding ParentColor}" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center" Opacity="0.8"/>

                                            <Border Grid.Column="1" HeightRequest="10" WidthRequest="10" StrokeShape="RoundRectangle 5" BackgroundColor="{Binding Color}" StrokeThickness="0" VerticalOptions="Center" Margin="0,0,10,0"/>

                                            <Label Grid.Column="2" Text="{Binding Name}" TextColor="#CBD5E1" FontSize="15" VerticalOptions="Center" Margin="5,0"/>

                                            <Grid Grid.Column="3" Padding="20,0" VerticalOptions="Center">
                                                <Label Text="check_circle" FontFamily="MaterialIcons" TextColor="#00E676" FontSize="22" IsVisible="{Binding IsSelected}"/>
                                                <Label Text="radio_button_unchecked" FontFamily="MaterialIcons" TextColor="#334155" FontSize="22" IsVisible="{Binding IsSelected, Converter={StaticResource InvertedBoolConverter}}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>

                            <BoxView HeightRequest="1" Color="#1E293B" Margin="20,5,20,5"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>

        <Border Grid.Row="2" BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 0" Padding="20,15,20,30">
            <Button Text="CONFIRMAR SELEÇÃO" 
                    Command="{Binding ConfirmSelectionCommand}" 
                    BackgroundColor="#00E676" 
                    TextColor="#001524" 
                    FontAttributes="Bold" 
                    FontSize="15" 
                    HeightRequest="55" 
                    CornerRadius="12"/>
        </Border>
    </Grid>
</ContentPage>