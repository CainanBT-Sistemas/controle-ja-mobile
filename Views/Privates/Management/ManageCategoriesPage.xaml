<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             xmlns:converters="clr-namespace:controle_ja_mobile.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="controle_ja_mobile.Views.Privates.Management.ManageCategoriesPage"
             x:Name="BrowseCategoriesPage"
             BackgroundColor="#001524" 
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToArrowConverter x:Key="BoolToArrowConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10">
            <ImageButton Grid.Column="0" Source="arrow_back_36dp.png" Command="{Binding GoBackCommand}" HeightRequest="24" HorizontalOptions="Start" Aspect="AspectFit">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                </ImageButton.Behaviors>
            </ImageButton>
            <Label Grid.Column="1" Text="Categorias" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Border Grid.Column="2" BackgroundColor="#00E676" StrokeThickness="0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAddRootCategoryCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="+" TextColor="#001524" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="22" Margin="0,-2,0,0"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="20,0,20,15" StrokeThickness="0" BackgroundColor="#1E2A3A" HeightRequest="45" StrokeShape="RoundRectangle 22">
            <Grid ColumnDefinitions="*, *">
                <Grid Grid.Column="0">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="DESPESA"/>
                    </Grid.GestureRecognizers>
                    <Border x:Name="TabExpense" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 22">
                        <Label Text="DESPESAS" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" 
                               TextColor="{Binding IsExpensesSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True'}"/>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsExpensesSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#2D3B4E"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="RECEITA"/>
                    </Grid.GestureRecognizers>
                    <Border x:Name="TabIncome" StrokeThickness="0" BackgroundColor="Transparent" StrokeShape="RoundRectangle 22">
                        <Label Text="RECEITAS" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" 
                               TextColor="{Binding IsExpensesSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='False'}"/>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsExpensesSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="#2D3B4E"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCategoriesCommand}" RefreshColor="#00E676">
            <CollectionView ItemsSource="{Binding DisplayedCategories}" Margin="0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <VerticalStackLayout>

                            <Border StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="70">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoriesViewModel}}, Path=OpenCategoryDetailsCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#151F2D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="70, *, Auto, 40" Padding="15,0">
                                    <Border Grid.Column="0" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="{Binding Color}" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>

                                    <Border Grid.Column="2" BackgroundColor="#2D3B4E" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="24" Padding="8,0" Margin="0,0,5,0" VerticalOptions="Center" IsVisible="{Binding HasChildren}">
                                        <Label Text="{Binding ChildrenCount}" TextColor="#A1A1AA" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <Label Grid.Column="3" Text="&#xe5cc;" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center"/>
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" Color="#1E2A3A" Margin="15,0,15,0"/>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>