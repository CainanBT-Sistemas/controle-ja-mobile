<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:behaviors="clr-namespace:controle_ja_mobile.Behaviors"
             x:Class="controle_ja_mobile.Views.Privates.Management.AccountAddPage"
             x:Name="RootPage"
             BackgroundColor="#001524" 
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10">
                <ImageButton Grid.Column="0" Source="arrow_back_36dp.png" Command="{Binding GoBackCommand}" HeightRequest="24" HorizontalOptions="Start" Aspect="AspectFit">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </ImageButton.Behaviors>
                </ImageButton>
                <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,10,20,20" Spacing="25">

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Pré-visualização" TextColor="#64748B" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Border HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 40" BackgroundColor="{Binding SelectedColor}" StrokeThickness="0">
                            <Label Text="{Binding SelectedIcon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome da Conta" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Entry Text="{Binding Name}" Placeholder="Ex: Nubank, Carteira Física..." PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Tipo da Conta" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Picker ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedAccountType}" TextColor="White" TitleColor="#64748B" BackgroundColor="Transparent" FontSize="16" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Instituição (Opcional)" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Entry Text="{Binding Institution}" Placeholder="Ex: Banco Itaú" PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Saldo Atual" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Entry Text="{Binding Balance}" IsEnabled="{Binding IsEditMode, Converter={toolkit:InvertedBoolConverter}}" Keyboard="Numeric" Placeholder="0.00" PlaceholderColor="#64748B" TextColor="#00E676" FontAttributes="Bold" FontSize="16" BackgroundColor="Transparent">
                                <Entry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior />
                                </Entry.Behaviors>
                            </Entry>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Cor de Identificação" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenColorSelectorCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="{Binding SelectedColor}" StrokeThickness="0" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Alterar Cor" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ícone" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenIconSelectorCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="{Binding SelectedIcon}" FontFamily="MaterialIcons" TextColor="White" FontSize="26" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Alterar Ícone" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Padding="20,0,20,20" Spacing="10">
                <Button Text="Salvar Conta" Command="{Binding SaveCommand}" BackgroundColor="#00E676" TextColor="#001524" FontAttributes="Bold" FontSize="16" HeightRequest="55" CornerRadius="12"/>

                <Button Text="Excluir Conta" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" BackgroundColor="Transparent" TextColor="#FF5252" BorderColor="#FF5252" BorderWidth="1" FontAttributes="Bold" FontSize="14" HeightRequest="50" CornerRadius="12"/>
            </VerticalStackLayout>

        </Grid>

        <Grid BackgroundColor="#B3000000" IsVisible="{Binding IsColorSelectorOpen}" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseColorSelectorCommand}"/>
            </Grid.GestureRecognizers>
            <Border VerticalOptions="End" BackgroundColor="#151E28" StrokeThickness="0" Margin="0" Padding="20,25,20,40" StrokeShape="RoundRectangle 25,25,0,0">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Selecione uma Cor" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <ScrollView MaximumHeightRequest="400">
                        <FlexLayout BindableLayout.ItemsSource="{Binding AvailableColors}" Wrap="Wrap" JustifyContent="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="{Binding .}" StrokeThickness="0" Margin="10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectColorCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid BackgroundColor="#B3000000" IsVisible="{Binding IsIconSelectorOpen}" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseIconSelectorCommand}"/>
            </Grid.GestureRecognizers>
            <Border VerticalOptions="End" BackgroundColor="#151E28" StrokeThickness="0" Margin="0" Padding="20,25,20,40" StrokeShape="RoundRectangle 25,25,0,0">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Selecione um Ícone" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <ScrollView MaximumHeightRequest="400">
                        <FlexLayout BindableLayout.ItemsSource="{Binding AvailableIcons}" Wrap="Wrap" JustifyContent="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border HeightRequest="60" WidthRequest="60" StrokeShape="RoundRectangle 12" BackgroundColor="#1E2A3A" StrokeThickness="0" Margin="8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectIconCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}" FontFamily="MaterialIcons" TextColor="White" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>