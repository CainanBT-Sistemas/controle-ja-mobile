<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="controle_ja_mobile.Views.Privates.Management.CategoryAddPage"
             x:Name="RootPage"
             BackgroundColor="#001524" 
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10">
                <ImageButton Grid.Column="0" Source="arrow_back_36dp.png" Command="{Binding GoBackCommand}" HeightRequest="24" HorizontalOptions="Start" Aspect="AspectFit">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </ImageButton.Behaviors>
                </ImageButton>
                <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,10,20,20" Spacing="25">

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Pré-visualização" TextColor="#64748B" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Border HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 40" BackgroundColor="{Binding SelectedColor}" StrokeThickness="0">
                            <Label Text="{Binding SelectedIcon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome da Categoria" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Entry Text="{Binding Name}" Placeholder="Ex: Netflix, Padaria..." PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5" IsVisible="{Binding IsTypeSelectionEnabled}">
                        <Label Text="Tipo de Transação" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="10,0">
                            <Picker ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding SelectedTransactionType}" TextColor="White" TitleColor="#64748B" BackgroundColor="Transparent" FontSize="16" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Cor de Identificação" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenColorSelectorCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Grid.Column="0" HeightRequest="30" WidthRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="{Binding SelectedColor}" StrokeThickness="0" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Alterar Cor" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Ícone" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="55" StrokeShape="RoundRectangle 8" Padding="15,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenIconSelectorCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Grid.Column="0" Text="{Binding SelectedIcon}" FontFamily="MaterialIcons" TextColor="White" FontSize="26" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Alterar Ícone" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                                <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E2A3A" Margin="0,10" IsVisible="{Binding IsEditMode}"/>

                    <VerticalStackLayout Spacing="15" IsVisible="{Binding IsEditMode}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Subcategorias" TextColor="#A1A1AA" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Border Grid.Column="1" BackgroundColor="#00E676" StrokeThickness="0" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToAddSubCategoryCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="+" TextColor="#001524" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20" Margin="0,-2,0,0"/>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <StackLayout BindableLayout.ItemsSource="{Binding SubCategories}">
                                <BindableLayout.EmptyView>
                                    <Label Text="Nenhuma subcategoria." TextColor="#64748B" HorizontalOptions="Center" Margin="0,20"/>
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Category">
                                        <VerticalStackLayout>

                                            <Border StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="60">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CategoryAddViewModel}}, Path=OpenCategoryDetailsCommand}" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>

                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="#2D3B4E" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Grid ColumnDefinitions="60, *, Auto, 40" Padding="10,0">
                                                    <Border Grid.Column="0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="{Binding Color}" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>

                                                    <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>

                                                    <Border Grid.Column="2" BackgroundColor="#151F2D" StrokeThickness="0" StrokeShape="RoundRectangle 10" HeightRequest="20" Padding="6,0" Margin="0,0,10,0" VerticalOptions="Center" IsVisible="{Binding HasChildren}">
                                                        <Label Text="{Binding ChildrenCount}" TextColor="#A1A1AA" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>

                                                    <Label Grid.Column="3" Text="&#xe5cc;" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                </Grid>
                                            </Border>

                                            <BoxView HeightRequest="1" Color="#151F2D" Margin="15,0"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </StackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="2" Padding="20,0,20,20" Spacing="10">
                <Button Text="Salvar Categoria" Command="{Binding SaveCommand}" BackgroundColor="#00E676" TextColor="#001524" FontAttributes="Bold" FontSize="16" HeightRequest="55" CornerRadius="12"/>
                <Button Text="Excluir Categoria" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}" BackgroundColor="Transparent" TextColor="#FF5252" BorderColor="#FF5252" BorderWidth="1" FontAttributes="Bold" FontSize="14" HeightRequest="50" CornerRadius="12"/>
            </VerticalStackLayout>

        </Grid>

        <Grid BackgroundColor="#B3000000" IsVisible="{Binding IsColorSelectorOpen}" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseColorSelectorCommand}"/>
            </Grid.GestureRecognizers>
            <Border VerticalOptions="End" BackgroundColor="#151E28" StrokeThickness="0" Margin="0" Padding="20,25,20,40" StrokeShape="RoundRectangle 25,25,0,0">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Selecione uma Cor" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <FlexLayout BindableLayout.ItemsSource="{Binding AvailableColors}" Wrap="Wrap" JustifyContent="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" BackgroundColor="{Binding .}" StrokeThickness="0" Margin="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectColorCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid BackgroundColor="#B3000000" IsVisible="{Binding IsIconSelectorOpen}" InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseIconSelectorCommand}"/>
            </Grid.GestureRecognizers>
            <Border VerticalOptions="End" BackgroundColor="#151E28" StrokeThickness="0" Margin="0" Padding="20,25,20,40" StrokeShape="RoundRectangle 25,25,0,0">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Selecione um Ícone" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <FlexLayout BindableLayout.ItemsSource="{Binding AvailableIcons}" Wrap="Wrap" JustifyContent="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border HeightRequest="60" WidthRequest="60" StrokeShape="RoundRectangle 12" BackgroundColor="#1E2A3A" StrokeThickness="0" Margin="8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Path=BindingContext.SelectIconCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}" FontFamily="MaterialIcons" TextColor="White" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>