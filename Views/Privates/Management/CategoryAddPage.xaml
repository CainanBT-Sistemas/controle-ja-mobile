<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="controle_ja_mobile.Views.Privates.Management.CategoryAddPage"
             x:Name="RootPage"
             BackgroundColor="#001524" 
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10">
            <ImageButton Grid.Column="0" Source="arrow_back_36dp.png" Command="{Binding GoBackCommand}" HeightRequest="24" HorizontalOptions="Start" Aspect="AspectFit">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                </ImageButton.Behaviors>
            </ImageButton>
            <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,20" Spacing="25">

                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Pré-visualização" TextColor="#64748B" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Frame HasShadow="False" HeightRequest="80" WidthRequest="80" CornerRadius="40" BackgroundColor="{Binding SelectedColor}" BorderColor="Transparent" Padding="0">
                        <Label Text="{Binding SelectedIcon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Nome da Categoria" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                    <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                        <Entry Text="{Binding Name}" Placeholder="Ex: Netflix, Padaria..." PlaceholderColor="#64748B" TextColor="White" FontSize="16" BackgroundColor="Transparent"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5" IsVisible="{Binding IsTypeSelectionEnabled}">
                    <Label Text="Tipo de Transação" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                    <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="10,0">
                        <Picker ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding SelectedTransactionType}" TextColor="White" TitleColor="#64748B" BackgroundColor="Transparent" FontSize="16" VerticalOptions="Center"/>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Cor de Identificação" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                    <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenColorSelectorCommand}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Frame Grid.Column="0" HasShadow="False" HeightRequest="30" WidthRequest="30" CornerRadius="15" BackgroundColor="{Binding SelectedColor}" BorderColor="Transparent" Padding="0" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Alterar Cor" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                            <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Ícone" TextColor="#A1A1AA" FontSize="14" FontAttributes="Bold"/>
                    <Frame HasShadow="False" BackgroundColor="#1E2A3A" BorderColor="Transparent" HeightRequest="55" CornerRadius="8" Padding="15,0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenIconSelectorCommand}"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Grid.Column="0" Text="{Binding SelectedIcon}" FontFamily="MaterialIcons" TextColor="White" FontSize="26" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Alterar Ícone" TextColor="White" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                            <Label Grid.Column="2" Text="▼" TextColor="#64748B" FontSize="14" VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" Color="#1E2A3A" Margin="0,10" IsVisible="{Binding IsEditMode}"/>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,0,20,20" Spacing="10">
            <Button Text="Salvar Categoria" Command="{Binding SaveCommand}" BackgroundColor="#00E676" TextColor="#001524" FontAttributes="Bold" FontSize="16" HeightRequest="55" CornerRadius="12"/>
            <Button Text="Excluir Categoria" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}" BackgroundColor="Transparent" TextColor="#FF5252" BorderColor="#FF5252" BorderWidth="1" FontAttributes="Bold" FontSize="14" HeightRequest="50" CornerRadius="12"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>