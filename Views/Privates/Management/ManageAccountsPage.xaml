<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:controle_ja_mobile.ViewModels"
             xmlns:models="clr-namespace:controle_ja_mobile.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="controle_ja_mobile.Views.Privates.Management.ManageAccountsPage"
             BackgroundColor="#001524" 
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="15,20,15,10">
            <ImageButton Grid.Column="0" Source="arrow_back_36dp.png" Command="{Binding GoBackCommand}" HeightRequest="24" HorizontalOptions="Start" Aspect="AspectFit">
                <ImageButton.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                </ImageButton.Behaviors>
            </ImageButton>
            <Label Grid.Column="1" Text="Contas e Carteiras" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            <Border Grid.Column="2" BackgroundColor="#00E676" StrokeThickness="0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAddAccountCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="+" TextColor="#001524" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="22" Margin="0,-2,0,0"/>
            </Border>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadAccountsCommand}" RefreshColor="#00E676">
            <CollectionView ItemsSource="{Binding Accounts}" Margin="0,10,0,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" Margin="0,50,0,0">
                        <Border BackgroundColor="#1E2A3A" StrokeThickness="0" HeightRequest="100" WidthRequest="100" StrokeShape="RoundRectangle 50">
                            <Label Text="&#xe84f;" FontFamily="MaterialIcons" TextColor="#64748B" FontSize="50" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5"/>
                        </Border>
                        <Label Text="Nenhuma conta cadastrada" TextColor="#64748B" FontSize="16" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Account">
                        <VerticalStackLayout>
                            <Border StrokeThickness="0" BackgroundColor="Transparent" HeightRequest="80">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccountsViewModel}}, Path=OpenAccountDetailsCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#151F2D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Grid ColumnDefinitions="70, *, Auto, 40" Padding="15,0">

                                    <Border Grid.Column="0" HeightRequest="46" WidthRequest="46" StrokeShape="RoundRectangle 23" BackgroundColor="{Binding Color}" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}" FontFamily="MaterialIcons" TextColor="#001524" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Institution}" TextColor="#64748B" FontSize="12" IsVisible="{Binding Institution, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                                        <Label Text="{Binding TypeDisplay}" TextColor="#64748B" FontSize="12" IsVisible="{Binding Institution, Converter={StaticResource IsNullOrEmptyConverter}}"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding FormattedBalance}" TextColor="#00E676" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>

                                    <Label Grid.Column="3" Text="&#xe5cc;" FontFamily="MaterialIcons" TextColor="#3F3F46" FontSize="24" VerticalOptions="Center" HorizontalOptions="Center"/>
                                </Grid>
                            </Border>

                            <BoxView HeightRequest="1" Color="#1E2A3A" Margin="15,0,15,0"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>